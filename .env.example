JIRA_SITE=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_TOKEN=your-api-token
JIRA_PROJECT=BA

# Optional: serve HTTPS (run `make cert` first) and accept these extra host names/IPs.
# JIRA_LITE_TLS_CERT=certs/server.crt
# JIRA_LITE_TLS_KEY=certs/server.key
# JIRA_LITE_PUBLIC_HOSTS=192.168.0.113

# Optional: per-user "Sign in with Atlassian" (OAuth 2.0 3LO) instead of one shared API token.
# Setting ATLASSIAN_CLIENT_ID switches it on; JIRA_EMAIL/JIRA_TOKEN are then not needed.
# Create an OAuth 2.0 integration at https://developer.atlassian.com/console/myapps/ with the
# Jira scopes read:jira-work, write:jira-work, read:jira-user and the callback URL
# <JIRA_LITE_BASE_URL>/oauth/callback (exactly). Sessions live in memory: restarting the
# server signs everyone out. JIRA_LITE_BIND may be non-loopback only in this mode with TLS.
# ATLASSIAN_CLIENT_ID=your-client-id
# ATLASSIAN_CLIENT_SECRET=your-client-secret
# JIRA_LITE_BASE_URL=https://192.168.0.113:8765
# JIRA_LITE_BIND=0.0.0.0
